diff --git a/server/app.js b/server/app.js
new file mode 100644
index 0000000..685acb7
--- /dev/null
+++ b/server/app.js
@@ -0,0 +1,53 @@
+import express from 'express';
+import { fileURLToPath } from 'node:url';
+import { requireAuth } from './auth.js';
+import { groupsRouter } from './routes/groups.js';
+import { meRouter } from './routes/me.js';
+import { isSupabaseConfigured, supabaseKey, supabaseUrl } from './supabase.js';
+
+const clientDist = fileURLToPath(new URL('../client/dist/', import.meta.url));
+
+export function createApp() {
+  const app = express();
+  app.use(express.json({ limit: '16kb' }));
+
+  app.get('/api/health', async (_req, res) => {
+    let supabaseStatus = 'not_configured';
+
+    if (isSupabaseConfigured()) {
+      try {
+        const response = await fetch(`${supabaseUrl.replace(/\/$/, '')}/auth/v1/health`, {
+          headers: { apikey: supabaseKey },
+          signal: AbortSignal.timeout(5000),
+        });
+        supabaseStatus = response.ok ? 'connected' : 'unavailable';
+      } catch {
+        supabaseStatus = 'unavailable';
+      }
+    }
+
+    res.status(200).json({ status: 'ok', supabase: supabaseStatus });
+  });
+
+  // Everything below needs a signed-in user.
+  app.use('/api', requireAuth);
+  app.use('/api/me', meRouter);
+  app.use('/api/groups', groupsRouter);
+  app.use('/api', (_req, res) => res.status(404).json({ error: 'Not found.' }));
+
+  // Production: serve the built React app, including client-side routes like /join/<code>.
+  app.use(express.static(clientDist));
+  app.get(/^(?!\/api\/).*/, (_req, res, next) => {
+    res.sendFile('index.html', { root: clientDist }, (error) => error && next());
+  });
+
+  app.use((error, _req, res, _next) => {
+    if (error.type === 'entity.parse.failed') {
+      return res.status(400).json({ error: 'Request body must be valid JSON.' });
+    }
+    console.error(error);
+    return res.status(500).json({ error: 'Something went wrong. Try again.' });
+  });
+
+  return app;
+}
diff --git a/server/auth.js b/server/auth.js
new file mode 100644
index 0000000..07682d0
--- /dev/null
+++ b/server/auth.js
@@ -0,0 +1,37 @@
+import { createUserClient, getAuthClient, isSupabaseConfigured } from './supabase.js';
+
+// Express middleware: require a valid Supabase access token.
+//
+// The browser sends `Authorization: Bearer <access token>`. supabase.auth.getClaims()
+// checks the token's signature and expiry: with asymmetric signing keys it verifies
+// locally against the project's published keys (JWKS); with a legacy shared secret it
+// asks Supabase Auth. On success the request gets:
+//   req.user      { id, email, claims }
+//   req.supabase  a Supabase client that runs as this user, so RLS applies
+export async function requireAuth(req, res, next) {
+  if (!isSupabaseConfigured()) {
+    return res.status(503).json({ error: 'Supabase is not configured on the server.' });
+  }
+
+  const match = /^Bearer\s+(\S+)$/i.exec(req.get('authorization') ?? '');
+  if (!match) {
+    return res.status(401).json({ error: 'Sign in to continue.' });
+  }
+
+  const token = match[1];
+  let result;
+  try {
+    result = await getAuthClient().auth.getClaims(token);
+  } catch {
+    return res.status(401).json({ error: 'Your session is not valid. Sign in again.' });
+  }
+
+  const claims = result?.data?.claims;
+  if (result?.error || !claims?.sub || claims.role !== 'authenticated') {
+    return res.status(401).json({ error: 'Your session is not valid. Sign in again.' });
+  }
+
+  req.user = { id: claims.sub, email: claims.email, claims };
+  req.supabase = createUserClient(token);
+  return next();
+}
diff --git a/server/errors.js b/server/errors.js
new file mode 100644
index 0000000..e7ed097
--- /dev/null
+++ b/server/errors.js
@@ -0,0 +1,35 @@
+// Turn a Supabase (PostgREST / Postgres) error into an HTTP status and a message
+// that is safe to show to the user.
+const statusByCode = {
+  '42501': 403, // insufficient privilege, including "new row violates row-level security policy"
+  P0002: 404, // raised by join_group() for an unknown invite code
+  PGRST116: 404, // .single() found no row, e.g. because RLS hides it
+  '23505': 409, // unique violation, e.g. username taken
+  '23503': 409, // foreign key violation
+  '23514': 400, // check constraint
+  '22P02': 400, // invalid input syntax, e.g. a malformed uuid
+};
+
+function messageFor(error, status) {
+  switch (error?.code) {
+    case '42501':
+      // Messages we raise ourselves are written for users; Postgres' own are not.
+      return error.message?.includes('row-level security') || error.message?.includes('permission denied')
+        ? 'You are not allowed to do that.'
+        : error.message;
+    case 'P0002':
+      return error.message;
+    case 'PGRST116':
+      return 'Not found.';
+    case '23505':
+      return 'That value is already taken.';
+    default:
+      return status === 400 ? 'Check the values you entered.' : 'Something went wrong. Try again.';
+  }
+}
+
+export function sendSupabaseError(res, error) {
+  const status = statusByCode[error?.code] ?? 500;
+  if (status === 500) console.error('Supabase error:', error);
+  return res.status(status).json({ error: messageFor(error, status), code: error?.code });
+}
