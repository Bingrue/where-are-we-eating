@@ -0,0 +1,115 @@
+:root {
+  --bg: #f6f4f1;
+  --surface: #ffffff;
+  --text: #1f1d1a;
+  --muted: #6b665f;
+  --border: #e2ddd5;
+  --accent: #c2410c;
+  --accent-text: #ffffff;
+  --danger: #b91c1c;
+  --notice-bg: #ecfdf5;
+  --notice-text: #065f46;
+  color-scheme: light;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #171614;
+    --surface: #211f1c;
+    --text: #f1eee9;
+    --muted: #a39d94;
+    --border: #36322d;
+    --accent: #fb923c;
+    --accent-text: #1b1208;
+    --danger: #f87171;
+    --notice-bg: #0f2a22;
+    --notice-text: #a7f3d0;
+    color-scheme: dark;
+  }
+}
+
+* { box-sizing: border-box; }
+
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--text);
+  font: 16px/1.5 system-ui, -apple-system, 'Segoe UI', sans-serif;
+}
+
+header, main {
+  max-width: 760px;
+  margin: 0 auto;
+  padding: 16px;
+}
+
+header {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12px;
+  align-items: center;
+  justify-content: space-between;
+}
+
+header h1 { font-size: 1.25rem; margin: 0; }
+header h1 a { color: inherit; text-decoration: none; }
+h2 { margin-top: 0; }
+h3 { margin-bottom: 8px; }
+.card > h3:first-child { margin-top: 0; }
+
+.card {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  padding: 20px;
+  margin-bottom: 16px;
+}
+
+.narrow { max-width: 420px; margin-inline: auto; }
+.stack { display: grid; gap: 12px; }
+.row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
+.row input { flex: 1 1 220px; }
+.columns { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
+.columns .card { margin-bottom: 0; }
+.muted { color: var(--muted); }
+.error { color: var(--danger); margin: 8px 0; }
+.notice { background: var(--notice-bg); color: var(--notice-text); padding: 8px 12px; border-radius: 8px; }
+.links { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 0; }
+
+.list { list-style: none; padding: 0; margin: 0; }
+.list li {
+  display: flex;
+  justify-content: space-between;
+  gap: 12px;
+  flex-wrap: wrap;
+  padding: 10px 0;
+  border-bottom: 1px solid var(--border);
+}
+.list li:last-child { border-bottom: 0; }
+.list a { color: var(--accent); font-weight: 600; }
+
+label { display: grid; gap: 4px; font-weight: 500; }
+
+input {
+  font: inherit;
+  padding: 8px 10px;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  background: var(--bg);
+  color: var(--text);
+  min-width: 0;
+}
+
+button {
+  font: inherit;
+  padding: 8px 14px;
+  border-radius: 8px;
+  border: 1px solid var(--accent);
+  background: var(--accent);
+  color: var(--accent-text);
+  cursor: pointer;
+}
+button:disabled { opacity: 0.6; cursor: default; }
+button.secondary { background: transparent; color: var(--text); border-color: var(--border); }
+button.danger { background: transparent; color: var(--danger); border-color: var(--danger); margin-top: 12px; }
+button.link { background: none; border: 0; padding: 0; color: var(--accent); text-decoration: underline; }
