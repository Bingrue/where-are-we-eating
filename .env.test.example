# Used only by local integration tests and benchmarks. Point these at LOCAL Supabase
# (values from `npm run db -- status`). The secret key bypasses RLS: never commit it,
# never put it in client/.env, and never use it in the Express app.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Task 6 latency benchmark (requires Devon's RPCs):
BENCH_USERS=1,5,10,25,50
BENCH_SAMPLES=5
BENCH_POLL_MS=1000
